{
  "name": "appforge-swarm",
  "private": true,
  "workspaces": ["packages/*", "frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @appforge/backend\" \"npm run dev -w @appforge/frontend\"",
    "test": "npm run test -w @appforge/app-spec",
    "typecheck": "tsc --noEmit -p frontend",
    "build": "npm run build -w @appforge/frontend"
  },
  "devDependencies": { "concurrently": "^9.0.1", "typescript": "^5.6.3" }
}
